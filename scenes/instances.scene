# Three instances share one loaded mesh and texture set.
size 800 600
eye -2 1 3.5
center 0 -0.1 0
up 0 1 0
fov 55
light 1 1 1

instance ../obj/diablo3_pose/diablo3_pose.obj
translate -1.1 -0.25 0
rotate 0 25 0
scale 0.75 0.75 0.75

instance ../obj/diablo3_pose/diablo3_pose.obj
translate 0 -0.25 0
scale 0.75 0.75 0.75

instance ../obj/diablo3_pose/diablo3_pose.obj
translate 1.1 -0.25 0
rotate 0 -25 0
scale 0.75 0.75 0.75

instance ../obj/floor.obj
scale 2.5 1 2.5
